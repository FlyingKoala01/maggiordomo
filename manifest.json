{
  "manifest_version": 3,
  "name": "Maggiordomo",
  "short_name": "Maggiordomo",
  "version": "0.1.0",
  "description": "A developer's butler: dev links, markdown notes, JSON tools, encoders, JWT, hashes, regex and more. Everything stays local.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Maggiordomo",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/workbench/workbench.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "https://raw.githubusercontent.com/*",
        "https://gist.githubusercontent.com/*"
      ],
      "js": ["vendor/marked.min.js", "vendor/purify.min.js", "src/content/md-viewer.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "favicon",
    "clipboardWrite"
  ],
  "optional_permissions": ["downloads"],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "open-workbench": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Open the Maggiordomo workbench"
    },
    "save-current-tab": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current tab to dev links"
    }
  }
}
